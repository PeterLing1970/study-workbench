# NAS 用户，一般为 1000:1000
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 局域网访问端口：http://<NAS-IP>:8787
STUDY_PORT=8787

POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# 学生与家长账号，密码至少 12 位。
AUTH_USERNAME=student
AUTH_PASSWORD=change-this-student-password
AUTH_PARENT_USERNAME=parent
AUTH_PARENT_PASSWORD=change-this-parent-password
AUTH_SECRET=change-this-to-a-very-long-random-session-secret
AUTH_COOKIE_SECURE=false
# 允许的跨域来源（逗号分隔）。部署到公网 HTTPS 时改为你的实际域名，例如：
# TRUSTED_ORIGINS=https://your-domain.example.com,http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
AUTH_SESSION_HOURS=168

AI_PRIMARY_PROVIDER=deepseek
# 错题拍照识别使用的视觉模型：deepseek | gemini
AI_VISION_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# DeepSeek 视觉实验模型（deepseek-v4-flash 为纯文本，不支持图片）
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Gemini（可选）：在 https://aistudio.google.com 申请免费 key 后填入即可切换
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.7-flash

MAX_UPLOAD_MB=10
SEED_DEMO_DATA=false
AI_TIMEOUT_SECONDS=90

# 自动备份。NAS 正式部署时请使用项目目录之外的绝对路径。
BACKUP_HOST_DIR=/vol1/1000/Backup/study-workbench
# 每 86400 秒（一天）备份一次，保留最近 30 天。
BACKUP_INTERVAL_SECONDS=86400
# 失败后每小时重试，避免一次网络或磁盘波动导致整天没有备份。
BACKUP_RETRY_SECONDS=3600
BACKUP_RETENTION_DAYS=30
