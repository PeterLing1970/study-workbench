# 飞牛用户，一般为 1000:1000
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 局域网访问端口：http://192.168.1.74:8787
STUDY_PORT=8787

POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# 学生与家长账号，密码至少 12 位。
AUTH_USERNAME=student
AUTH_PASSWORD=change-this-student-password
AUTH_PARENT_USERNAME=parent
AUTH_PARENT_PASSWORD=change-this-parent-password
AUTH_SECRET=change-this-to-a-very-long-random-session-secret
AUTH_COOKIE_SECURE=false
TRUSTED_ORIGINS=https://study.rostai.top,http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_HOURS=168

AI_PRIMARY_PROVIDER=minimax
MINIMAX_API_KEY=
# 中国区账号使用 minimaxi.com；国际区账号改为 api.minimax.io/v1。
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

MAX_UPLOAD_MB=10
AI_TIMEOUT_SECONDS=90
